# --- Database (Postgres + pgvector, see docker-compose.yml) ---
DATABASE_URL=postgresql://lucid:lucid@localhost:5432/lucid

# --- Cache (Redis, see docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- LLM providers (free tiers — no paid APIs; see CLAUDE.md) ---
GROQ_API_KEY=
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_GRADER_MODEL=openai/gpt-oss-20b
# Free-tier defaults per ADR 0003 — overwrite with your own account's actual limits
# from the Groq console once you've confirmed them (see packages/eval smoke command).
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RPD=1000
GROQ_TPD=200000

GEMINI_API_KEY=
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# --- Embeddings (local, in-process — no API key needed) ---
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# Pinned per ADR 0001 — never "main"; a moving ref would silently change every vector.
EMBEDDING_REVISION=e9b6763023c676ca8431644204f50c2b100d9aab
EMBEDDING_DTYPE=fp32

# --- Retrieval / correction tuning ---
# Starting points only — revisit per ADR 0001 and ADR 0004 once measured.
RETRIEVAL_TOP_K=5
CACHE_SIMILARITY_THRESHOLD=0.92

# --- App ---
API_PORT=8080
NODE_ENV=development
