# --- Database (Postgres + pgvector, see docker-compose.yml) ---
DATABASE_URL=postgresql://lucid:lucid@localhost:5432/lucid

# --- Cache (Redis, see docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- LLM providers (free tiers — no paid APIs; see CLAUDE.md) ---
GROQ_API_KEY=
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_GRADER_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# --- Embeddings (local, in-process — no API key needed) ---
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_REVISION=main
EMBEDDING_DTYPE=fp32

# --- Retrieval / correction tuning ---
# Starting points only — revisit once ADR 0001 (chunking) and ADR 0004 (abstention policy)
# have measured evidence behind them.
RETRIEVAL_TOP_K=6
CACHE_SIMILARITY_THRESHOLD=0.92

# --- App ---
API_PORT=8080
NODE_ENV=development
